            $this->warn($issues, 'INSTALMENT_AMOUNT_DERIVED', 'Instalment amount was derived because loan_monthly_repayment_amount is blank/zero.');
        }

        $fields = [
            $names['surname'],
            $names['forename1'],
            $names['forename2'],
            $names['forename3'],
            '',
            $this->date8($row->crb_member_dob ?? null, $issues, 'DATE_OF_BIRTH_MISSING', true),
            $client,
            $account,
            $this->gender($row->crb_member_gender ?? null, $issues, true),
            strtoupper((string) $this->default('CRB_DEFAULT_NATIONALITY', 'KE')),
            $identity['type'],
            $identity['number'],
            $phone,
            'I',
            $financial['instalment_due_date'] ? $financial['instalment_due_date']->format('Ymd') : '',
            $this->money((float) $row->loan_amount),
            $currency,
            $currency === 'KES' ? $this->money($financial['current_balance']) : '',
            $this->money($financial['current_balance']),
            $this->money($financial['overdue_balance']),
            $financial['overdue_date'] ? $financial['overdue_date']->format('Ymd') : '',
            (string) $financial['days_in_arrears'],
            (string) $financial['instalments_in_arrears'],
            $risk,
            $status['code'],
            $status['date'] ? $status['date']->format('Ymd') : '',
            str_pad((string) $duration, 3, '0', STR_PAD_LEFT),
            $opened ? $opened->format('Ymd') : '',
            $this->money($instalment),
            $last['latest_date'] ? Carbon::parse($last['latest_date'], self::APP_TZ)->format('Ymd') : '',
            $this->money((float) $last['latest_cash']),
        ];

        return $this->recordEnvelope('MF', $fields, $issues, (int) $row->crb_member_id, (int) $row->loan_id, 'sacco_loans', (int) $row->loan_id, [
            'member' => $row->crb_member_name,
            'client_number' => $client,
            'account_number' => $account,
            'original_amount' => (float) $row->loan_amount,
            'current_balance' => $financial['current_balance'],
            'overdue_balance' => $financial['overdue_balance'],
            'days_in_arrears' => $financial['days_in_arrears'],
            'account_status' => $status['code'],
            'risk_classification' => $risk,
        ]);
    }

    private function recordEnvelope(
        string $code,
        array $fields,
        array $issues,
        ?int $memberId,
        ?int $loanId,
        string $sourceType,
        ?int $sourceId,
        array $summary
    ): array {
        if (count($fields) !== count(self::FIELD_NAMES[$code])) {
            throw new RuntimeException("Internal {$code} field-count mismatch: " . count($fields) . ' values for ' . count(self::FIELD_NAMES[$code]) . ' DST fields.');
        }

        $fields = array_map(fn ($value) => $this->cleanField($value), $fields);

        return [
            'fields' => $fields,
            'issues' => $issues,
            'member_id' => $memberId,
            'loan_id' => $loanId,
            'source_type' => $sourceType,
            'source_id' => $sourceId,
            'summary' => $summary,
            'pipe_row' => implode('|', $fields),
        ];
    }

    private function candidateCount(string $code, Carbon $date): int
    {
        return match ($code) {
            'CE' => $this->baseLoanQuery($date)->count(),
            'GI' => DB::table('sacco_loan_guarantors as g')
                ->join('sacco_loans as l', 'l.loan_id', '=', 'g.loan_guar_loan_id')
                ->where('l.loan_amount', '>', 0)
                ->where(function ($q) use ($date) {
                    $q->where('l.loan_taken_period', '<=', (int) $date->format('Ym'))
                        ->orWhere('l.loan_on', '<=', $this->snapshotEndDb($date));
                })
                ->where(function ($q) {
                    $q->whereNull('g.loan_guar_deleted')
                        ->orWhere('g.loan_guar_deleted', '<>', 'Y');
                })
                ->count(),
            'CA' => (function () use ($date) {
                [$startDb, $endDb] = $this->monthDbRange($date);

                return DB::table('sacco_loan_batch_trans_members')
                    ->whereBetween('batch_trans_on', [$startDb, $endDb])
                    ->count();
            })(),
            'DP' => DB::table('sacco_loan_payments')
                ->whereDate('loan_payments_paid_on', $date->format('Y-m-d'))
                ->distinct('loan_payments_loan_id')
                ->count('loan_payments_loan_id'),
            'MF' => (function () use ($date) {
                [$startDb, $endDb] = $this->dayDbRange($date);

                return DB::table('sacco_loans as l')
                    ->join('sacco_loan_types as lt', 'lt.loan_type_id', '=', 'l.loan_loan_type')
                    ->where('l.loan_amount', '>', 0)
                    ->where('lt.loan_type_instant_disbursement', 1)
                    ->whereBetween('l.loan_on', [$startDb, $endDb])
                    ->count();
            })(),
            default => 0,
        };
    }

    private function loanFinancialState(object $row, Carbon $date, array &$issues): array
    {
        $original = max(0, (float) ($row->loan_amount ?? 0));
        $stat = $this->paymentStat((int) $row->loan_id, $date);
        $principalPaid = (float) $stat['principal_total'];
        $today = Carbon::now(self::APP_TZ)->startOfDay();

        if ($date->greaterThanOrEqualTo($today)) {
            $headerPaid = (float) ($row->loan_loan_paid ?? 0);
            $currentBalance = $original - $headerPaid;

            if (abs($headerPaid - $principalPaid) > 1.00) {
                $this->warn($issues, 'HEADER_LEDGER_PAYMENT_VARIANCE', 'loan_loan_paid differs from the principal-payment ledger by more than KES 1. Current live balance trusts loan_amount - loan_loan_paid.');
            }
        } else {
            $currentBalance = $original - $principalPaid;
            $this->warn($issues, 'HISTORICAL_BALANCE_DERIVED_FROM_LEDGER', 'Historical current balance was reconstructed from principal payments posted on or before the CRB snapshot date.');
        }

        /*
         * SACCO loan-clearance rule.
         *
         * The operational application already treats a loan as cleared when:
         *
         *     loan_amount - loan_loan_paid <= threshold_amount
         *
         * The same rule must govern CRB account closure.
         *
         * Examples:
         * threshold_amount = 0  => balance 0 or any overpayment is cleared
         * threshold_amount = 10 => balances from KES 0.00 through KES 10.00
         *                          are considered cleared
         *
         * CRB Current Balance must never be negative. Once the member no
         * longer owes principal under the SACCO clearance rule, report zero.
         */
        $rawCurrentBalance = $currentBalance;
        $clearanceThreshold = $this->loanClearanceThreshold();

        if ($rawCurrentBalance <= $clearanceThreshold) {
            if ($rawCurrentBalance < -0.005) {
                $this->warn(
                    $issues,
                    'OVERPAID_BALANCE_NORMALISED_TO_ZERO',
                    'The calculated principal balance is below zero because principal paid exceeds the original loan amount. The facility is cleared under the SACCO threshold rule and CRB Current Balance is reported as zero.'
                );
            } elseif ($rawCurrentBalance > 0.005 && $clearanceThreshold > 0) {
                $this->warn(
                    $issues,
                    'BALANCE_WITHIN_CLEARANCE_THRESHOLD',
                    'The remaining principal balance is within the SACCO threshold_amount and is therefore treated as cleared for CRB reporting.'
                );
            }

            $currentBalance = 0.0;
        }

        if ($currentBalance > $original + 1.00) {
            $this->warn($issues, 'BALANCE_EXCEEDS_ORIGINAL', 'Derived current balance exceeds original amount, usually because of a payment reversal or historical data adjustment.');
        }

        $schedule = $this->principalSchedule($row, $date, $issues);
        $availablePaid = max(0, $principalPaid);
        $overdue = 0.0;
        $overdueDate = null;
        $arrearsCount = 0;
        $nextUnpaidDue = null;

        foreach ($schedule as $instalment) {
            $scheduled = (float) $instalment['amount'];
            $allocated = min($scheduled, max(0, $availablePaid));
            $availablePaid -= $allocated;
            $unpaid = max(0, $scheduled - $allocated);

            if ($unpaid <= 0.005) {
                continue;
            }

            /** @var Carbon $due */
            $due = $instalment['due'];

            if ($due->lessThanOrEqualTo($date)) {
                $overdue += $unpaid;
                $arrearsCount++;

                if ($overdueDate === null) {
                    $overdueDate = $due->copy();
                }
            } elseif ($nextUnpaidDue === null) {
                $nextUnpaidDue = $due->copy();
            }
        }

        $overdue = min(max(0, $overdue), max(0, $currentBalance));
        $days = $overdueDate ? max(0, $overdueDate->diffInDays($date, false)) : 0;

        if ($overdue <= 0.005 || $currentBalance <= 0.005) {
            $overdue = 0.0;
            $overdueDate = null;
            $days = 0;
            $arrearsCount = 0;
        }

        $threshold = (float) $this->default('CRB_NEGATIVE_INFORMATION_THRESHOLD', 1000);
        if ($overdue > 0 && $overdue <= $threshold) {
            $this->warn(
                $issues,
                'NEGATIVE_INFORMATION_THRESHOLD_REVIEW',
                'The overdue amount is at or below the configured negative-information threshold. This does not alter the contractual CRB balance/arrears snapshot; review the applicable negative-information reporting treatment before submission.'
            );
        }

        $instalmentDueDate = $overdueDate ?: $nextUnpaidDue;

        return [
            'raw_current_balance' => round($rawCurrentBalance, 2),
            'clearance_threshold' => round($clearanceThreshold, 2),
            'current_balance' => round($currentBalance, 2),
            'overdue_balance' => round($overdue, 2),
            'overdue_date' => $overdueDate,
            'days_in_arrears' => (int) $days,
            'instalments_in_arrears' => (int) $arrearsCount,
            'instalment_due_date' => $instalmentDueDate,
            'next_unpaid_due' => $nextUnpaidDue,
            'principal_paid_to_date' => round($principalPaid, 2),
        ];
    }

    /**
     * SACCO operational threshold below/at which a loan is considered cleared.
     *
     * This is an existing SACCO-wide setting used by the loan module; CRB must
     * not maintain a separate competing clearance threshold.
     */
    private function loanClearanceThreshold(): float
    {
        $value = $this->default('threshold_amount', 0);

        if (!is_numeric($value)) {
            return 0.0;
        }

        return max(0.0, (float) $value);
    }

    private function principalSchedule(object $row, Carbon $date, array &$issues): array
    {
        $original = max(0, (float) ($row->loan_amount ?? 0));
        $duration = $this->repaymentPeriod($row, $issues);
        $opened = $this->loanOpenedDate($row, $date, $issues);
        $instant = (int) ($row->crb_instant ?? 0) === 1;

        if ($original <= 0 || $duration <= 0) {
            return [];
        }

        if ($instant) {
            $due = ($opened ?: $date)->copy()->addMonthNoOverflow()->startOfDay();

            return [[
                'number' => 1,
                'due' => $due,
                'amount' => $original,
            ]];
        }

        $firstDue = $this->firstScheduledDueDate($row, $date, $issues);
        $principal = (float) ($row->loan_monthly_repayment_principal ?? 0);

        if ($principal <= 0) {
            $principal = $original / $duration;
            $this->warn($issues, 'MONTHLY_PRINCIPAL_DERIVED', 'Monthly principal was derived from original amount divided by repayment period because loan_monthly_repayment_principal is blank/zero.');
        }

        $schedule = [];
        $remaining = $original;

        for ($i = 1; $i <= $duration; $i++) {
            $due = $firstDue->copy()->addMonthsNoOverflow($i - 1)->endOfMonth()->startOfDay();

            if ($i === $duration) {
                $amount = $remaining;
            } else {
                $amount = min($principal, $remaining);
            }

            $amount = max(0, $amount);
            $remaining = max(0, $remaining - $amount);

            $schedule[] = [
                'number' => $i,
                'due' => $due,
                'amount' => $amount,
            ];
        }

        if ($remaining > 0.005 && $schedule !== []) {
            $last = array_key_last($schedule);
            $schedule[$last]['amount'] += $remaining;
        }

        return $schedule;
    }

    private function firstScheduledDueDate(object $row, Carbon $date, array &$issues): Carbon
    {
        $periods = [
            (int) ($row->loan_start_deduction_period ?? 0),
            (int) ($row->loan_taken_start_period ?? 0),
            (int) ($row->loan_taken_period ?? 0),
        ];

        foreach ($periods as $period) {
            $text = (string) $period;

            if (preg_match('/^\d{6}$/', $text) && substr($text, 4, 2) >= '01' && substr($text, 4, 2) <= '12') {
                return Carbon::createFromFormat('Ym', $text, self::APP_TZ)->endOfMonth()->startOfDay();
            }
        }

        $opened = $this->loanOpenedDate($row, $date, $issues);

        if ($opened) {
            $this->warn($issues, 'FIRST_DUE_DATE_DERIVED_FROM_OPEN_DATE', 'First contractual due month was unavailable; due date was derived from the loan opening month.');

            return $opened->copy()->endOfMonth()->startOfDay();
        }

        $this->error($issues, 'FIRST_DUE_DATE_MISSING', 'Unable to derive the first contractual instalment due date.');

        return $date->copy()->endOfMonth()->startOfDay();
    }

    private function repaymentPeriod(object $row, array &$issues): int
    {
        $duration = (int) ($row->loan_payment_period ?? 0);

        if ($duration <= 0) {
            $duration = (int) ($row->crb_loan_type_duration ?? 0);
            if ($duration > 0) {
                $this->warn($issues, 'REPAYMENT_PERIOD_FROM_LOAN_TYPE', 'Loan repayment period was blank/zero and was taken from the current loan-type duration.');
            }
        }

        if ($duration <= 0) {
            $duration = 1;
            $this->error($issues, 'REPAYMENT_PERIOD_MISSING', 'Repayment period is missing; a temporary value of 1 month was used for validation output.');
        }

        return min($duration, 999);
    }

    private function loanOpenedDate(object $row, Carbon $snapshot, array &$issues): ?Carbon
    {
        $opened = $this->dbDateToNairobi($row->loan_on ?? null);

        if ($opened && $opened->lessThanOrEqualTo($snapshot->copy()->endOfDay())) {
            return $opened->startOfDay();
        }

        $period = (string) ((int) ($row->loan_taken_period ?? 0));

        if (preg_match('/^\d{6}$/', $period) && substr($period, 4, 2) >= '01' && substr($period, 4, 2) <= '12') {
            $derived = Carbon::createFromFormat('Ym', $period, self::APP_TZ)->startOfMonth()->startOfDay();

            if ($opened && $opened->greaterThan($snapshot)) {
                $this->warn($issues, 'OPEN_DATE_DERIVED_FROM_PERIOD_FOR_MIGRATED_LOAN', 'loan_on is later than the historical snapshot; opening/disbursement date was derived from loan_taken_period for this migrated loan.');
            } else {
                $this->warn($issues, 'OPEN_DATE_DERIVED_FROM_PERIOD', 'Opening/disbursement date was derived from loan_taken_period because loan_on is unavailable.');
            }

            return $derived;
        }

        $this->error($issues, 'OPEN_DATE_MISSING', 'Loan opening/disbursement date cannot be determined.');

        return null;
    }

    private function accountStatus(
        object $row,
        array $financial,
        Carbon $date,
        array &$issues,
        ?Carbon $opened = null
    ): array {
        /*
         * Closed amortising facility.
         * Status H (Settled) is reserved for revolving facilities.
         */
        if ((float) $financial['current_balance'] <= 0.005) {
            $stat = $this->paymentStat((int) $row->loan_id, $date);

            if (!$stat['latest_date']) {
                $this->error(
                    $issues,
                    'CLOSED_STATUS_DATE_MISSING',
                    'Loan is closed/cleared but no reliable final payment date is available. Account Status Date must not be fabricated.'
                );

                return ['code' => 'A', 'date' => null];
            }

            return [
                'code' => 'A',
                'date' => Carbon::parse($stat['latest_date'], self::APP_TZ)->startOfDay(),
            ];
        }

        /*
         * SACCO operational suspension maps to CRB K - Suspended.
         */
        $stopped = strtoupper((string) ($row->loan_stoped ?? 'N')) === 'Y';

        if ($stopped) {
            $suspended = null;

            foreach (['loan_suspended_on', 'loan_stopped_on', 'loan_stoped_on'] as $field) {
                if (property_exists($row, $field) && $row->{$field}) {
                    $suspended = $this->dbDateToNairobi($row->{$field});

                    if ($suspended) {
                        break;
                    }
                }
            }

            if (!$suspended) {
                $this->error(
                    $issues,
                    'SUSPENSION_DATE_MISSING',
                    'Loan is suspended but the date suspension began is missing. CRB Account Status Date must not be defaulted to the report date.'
                );

                return ['code' => 'K', 'date' => null];
            }

            return ['code' => 'K', 'date' => $suspended->startOfDay()];
        }

        /*
         * Active facility. Until a formal status-history mechanism exists,
         * the opening/disbursement date is the defensible initial F-status date.
         */
        if (!$opened) {
            $this->error(
                $issues,
                'ACTIVE_STATUS_DATE_MISSING',
                'Active loan has no reliable opening/disbursement date from which to establish its Account Status Date.'
            );

            return ['code' => 'F', 'date' => null];
        }

        return ['code' => 'F', 'date' => $opened->copy()->startOfDay()];
    }

    private function riskClass(int $days, int $instalments, float $overdue): string
    {
        /*
         * SACCO statutory delinquency classification:
         *
         * A Performing   - performing according to contractual terms
         * B Watch        - 1-30 days OR 1 instalment outstanding
         * C Substandard  - 31-180 days OR 2-6 instalments outstanding
         * D Doubtful     - 181-360 days OR 7-12 instalments outstanding
         * E Loss         - >360 days OR >12 instalments outstanding
         *
         * Where the day and instalment tests differ, use the worse class.
         */
        if ($overdue <= 0.005 && $instalments <= 0) {
            return 'A';
        }

        $dayClass = match (true) {
            $days > 360 => 5,
            $days > 180 => 4,
            $days > 30 => 3,
            $days >= 1 => 2,
            default => 1,
        };

        $instalmentClass = match (true) {
            $instalments > 12 => 5,
            $instalments >= 7 => 4,
            $instalments >= 2 => 3,
            $instalments >= 1 => 2,
            default => 1,
        };

        return match (max($dayClass, $instalmentClass)) {
            5 => 'E',
            4 => 'D',
            3 => 'C',
            2 => 'B',
            default => 'A',
        };
    }

    private function nextInstalmentAmount(object $row, array $financial): float
    {
        if ((float) $financial['current_balance'] <= 0.005) {
            return 0;
        }

        if ((int) ($row->crb_instant ?? 0) === 1) {
            return (float) $financial['current_balance'];
        }

        $emi = (float) ($row->loan_monthly_repayment_amount ?? 0);

        if ($emi > 0) {
            return $emi;
        }

        $principal = (float) ($row->loan_monthly_repayment_principal ?? 0);

        return $principal > 0
            ? min($principal, (float) $financial['current_balance'])
            : (float) $financial['current_balance'];
    }

    private function paymentFrequency(object $row): string
    {
        return (int) ($row->crb_instant ?? 0) === 1 ? 'B' : 'M';
    }

    private function productType(object $row, array &$issues): string
    {
