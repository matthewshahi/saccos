        $phone = $this->phone((string) ($row->crb_member_phone ?? ''), $issues, false);
        $opened = $this->loanOpenedDate($row, $date, $issues);
        $financial = $this->loanFinancialState($row, $date, $issues);
        $status = $this->accountStatus($row, $financial, $date, $issues, $opened);
        $risk = $this->riskClass((int) $financial['days_in_arrears'], (int) $financial['instalments_in_arrears'], (float) $financial['overdue_balance']);
        $duration = $this->repaymentPeriod($row, $issues);
        $account = $this->accountNumber((int) $row->loan_id, $issues);
        $client = $this->clientNumber($row, $issues);
        $currency = strtoupper((string) $this->default('CRB_DEFAULT_CURRENCY', 'KES'));
        $nationality = strtoupper((string) $this->default('CRB_DEFAULT_NATIONALITY', 'KE'));
        $security = strtoupper((string) $this->default('CRB_DEFAULT_SECURITY_TYPE', 'U'));

        if ($security === '') {
            $security = 'U';
        }

        $this->warn($issues, 'SECURITY_DEFAULTED_TO_U', 'Security type is currently defaulted to U (Unsecured) until a facility-specific collateral/security mapping is configured.');
        $this->warn($issues, 'NAME_DERIVED_FROM_FULL_NAME', 'Surname and forenames were derived from member_name because the member master stores a full name.');

        $address = $this->cleanText((string) ($row->crb_member_address ?? ''), 70);
        if ($address !== '') {
            $this->warn($issues, 'ADDRESS_DERIVED_FROM_MEMBER_ADDRESS', 'The available member address was reused for CRB postal/physical address fields.');
