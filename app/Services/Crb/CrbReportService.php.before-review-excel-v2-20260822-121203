        $payment = (float) ($row->crb_day_cash ?? 0);

        if (!$previouslyReported) {
            $this->error($issues, 'ACCOUNT_NOT_PREVIOUSLY_REPORTED', 'Daily Payment can only update an account that has already been reported in a finalised/submitted CE or MF report.');
        }

        $this->warn($issues, 'NAME_DERIVED_FROM_FULL_NAME', 'Surname and forenames were derived from member_name because the member master stores a full name.');

        $fields = [
            $date->format('Ymd'),
            'A',
            $names['surname'],
            $names['forename1'],
            $names['forename2'],
            $names['forename3'],
            '',
            $identity['type'],
            $identity['number'],
            $account,
            strtoupper((string) $this->default('CRB_DEFAULT_CURRENCY', 'KES')),
