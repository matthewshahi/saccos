    private function buildCaRecord(object $row, Carbon $date): array
    {
        $issues = [];
        $names = $this->splitName((string) $row->crb_member_name, $issues);
        $identity = $this->identityFromValues($row->crb_member_national_id ?? null, $issues, true);
        $client = trim((string) ($row->crb_member_sacco_id ?? ''));

        if ($client === '') {
            $client = (string) $row->crb_member_id;
            $this->warn($issues, 'CLIENT_NUMBER_FALLBACK', 'Member ID was used because member_sacco_id is blank.');
        }

        $applicationDate = $this->dbDateToNairobi($row->batch_trans_on ?? null);
        if (!$applicationDate) {
            $this->error($issues, 'APPLICATION_DATE_MISSING', 'Application date is missing or invalid.');
        }

        $deleted = strtoupper((string) ($row->batch_trans_deleted ?? 'N')) === 'Y';
        $updated = strtoupper((string) ($row->batch_trans_updated ?? 'N')) === 'Y';

        if ($deleted) {
            $applicationStatus = 'D';
            $statusDate = $this->dbDateToNairobi($row->batch_trans_deleted_on ?? null) ?: $applicationDate ?: $date;
            $declineReason = '';
            $this->error($issues, 'DECLINE_REASON_MISSING', 'This application is rejected, but no CRB LOV25 decline reason code is stored.');
        } elseif ($updated) {
            $applicationStatus = 'H';
            $statusDate = $this->dbDateToNairobi($row->crb_linked_loan_on ?? null) ?: $applicationDate ?: $date;
            $declineReason = '';
        } else {
            $applicationStatus = 'A';
            $statusDate = $applicationDate ?: $date;
            $declineReason = '';
        }

        $linkedLoanId = (int) ($row->crb_linked_loan_id ?? 0);
        $account = $linkedLoanId > 0 ? $this->accountNumber($linkedLoanId, $issues) : '';
        $applicationNumber = 'APP' . str_pad((string) $row->batch_trans_id, 12, '0', STR_PAD_LEFT);

        $this->warn($issues, 'NAME_DERIVED_FROM_FULL_NAME', 'Surname and forenames were derived from member_name because the member master stores a full name.');

        $fields = [
            $this->lenderRegisteredName(),
            $this->lenderTradingName(),
            $this->branchName(),
            $this->branchCode(),
            'A',
            $names['surname'],
            $names['forename1'],
            $names['forename2'],
            $names['forename3'],
            '',
            '',
            $identity['type'],
            $identity['number'],
            '',
            '',
            '',
            '',
            $this->cleanText($client, 20),
            $this->cleanText((string) ($row->crb_member_kra_pin ?? ''), 20),
            $account,
            $applicationDate ? $applicationDate->format('Ymd') : '',
            $this->cleanText($applicationNumber, 20),
            'U',
            $this->money((float) ($row->batch_trans_loan_amount ?? 0)),
            strtoupper((string) $this->default('CRB_DEFAULT_CURRENCY', 'KES')),
            ((int) ($row->crb_instant ?? 0) === 1) ? 'I' : 'H',
            str_pad((string) max(1, (int) ($row->batch_trans_loan_duration ?? 1)), 3, '0', STR_PAD_LEFT),
            $applicationStatus,
            $declineReason,
            $statusDate->format('Ymd'),
            '',
        ];

        return $this->recordEnvelope('CA', $fields, $issues, (int) $row->crb_member_id, $linkedLoanId ?: null, 'sacco_loan_batch_trans_members', (int) $row->batch_trans_id, [
            'applicant' => $row->crb_member_name,
            'application_number' => $applicationNumber,
            'application_amount' => (float) ($row->batch_trans_loan_amount ?? 0),
            'application_status' => $applicationStatus,
            'linked_loan_id' => $linkedLoanId ?: null,
        ]);
    }

    private function buildDpRecord(object $row, Carbon $date, bool $previouslyReported): array
