            $account,
            '',
            $this->gender($row->crb_member_gender ?? null, $issues, true),
            $nationality,
            '',
            $identity['type'],
            $identity['number'],
            '',
            '',
            '',
            '',
            '',
            $phone,
            '',
            '',
            $address,
            '',
            '',
            '',
            '',
            $address,
            '',
            '',
            '',
            '',
            '',
            $this->cleanText((string) ($row->crb_member_kra_pin ?? ''), 20),
            $this->cleanText((string) ($row->crb_member_email ?? ''), 100),
            $employer,
            '',
            '',
            '',
            '',
            $this->lenderRegisteredName(),
            $this->lenderTradingName(),
            $this->branchName(),
            $this->branchCode(),
            'S',
            $this->productType($row, $issues),
            $opened ? $opened->format('Ymd') : '',
            $financial['instalment_due_date'] ? $financial['instalment_due_date']->format('Ymd') : '',
            $this->money((float) $row->loan_amount),
            $currency,
            $currency === 'KES' ? $this->money($financial['current_balance']) : '',
            $this->money($financial['current_balance']),
            $this->money($financial['overdue_balance']),
            $financial['overdue_date'] ? $financial['overdue_date']->format('Ymd') : '',
            (string) $financial['days_in_arrears'],
            (string) $financial['instalments_in_arrears'],
            $risk,
            $status['code'],
            $status['date'] ? $status['date']->format('Ymd') : '',
            '',
            str_pad((string) $duration, 3, '0', STR_PAD_LEFT),
            '',
            '',
            $this->paymentFrequency($row),
            $opened ? $opened->format('Ymd') : '',
            $this->money($nextInstalment),
            $last['latest_date'] ? Carbon::parse($last['latest_date'], self::APP_TZ)->format('Ymd') : '',
            $this->money((float) $last['latest_cash']),
            $security,
            '',
        ];

        return $this->recordEnvelope('CE', $fields, $issues, (int) $row->crb_member_id, (int) $row->loan_id, 'sacco_loans', (int) $row->loan_id, [
            'member' => $row->crb_member_name,
