    private function accountNumber(int $loanId, array &$issues): string
    {
        $this->warn($issues, 'ACCOUNT_NUMBER_DERIVED_FROM_LOAN_ID', 'CRB account number is currently derived deterministically from loan_id. Keep this identifier stable once production CRB reporting begins.');

        return 'LN' . str_pad((string) $loanId, 12, '0', STR_PAD_LEFT);
