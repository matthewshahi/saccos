    public function validateStoredReport(int $reportId, ?int $userId = null, ?string $ip = null): stdClass
    {
        $report = $this->getReport($reportId);

        if (in_array($report->status, ['FINALISED', 'FINALIZED', 'SUBMITTED'], true)) {
            throw new RuntimeException('Finalised or submitted CRB reports are immutable.');
        }

        /*
         * DRAFT/VALIDATED snapshots may be revalidated under the current
         * policy. This only changes issue classification/status, not CRB field
         * values. Finalised/submitted reports remain immutable.
         */
        $this->reclassifyStoredRecordIssues($reportId);

        $reportIdCol = $this->requireColumn('records', 'report_id');
        $statusCol = $this->requireColumn('records', 'status');

        $counts = DB::table('sacco_crb_report_records')
            ->select($statusCol, DB::raw('COUNT(*) AS total'))
            ->where($reportIdCol, $reportId)
            ->groupBy($statusCol)
            ->pluck('total', $statusCol)
            ->mapWithKeys(fn ($value, $key) => [strtoupper((string) $key) => (int) $value])
            ->all();

        $total = array_sum($counts);
        $errors = $counts['ERROR'] ?? 0;
        $warnings = $counts['WARNING'] ?? 0;
        $valid = $counts['VALID'] ?? 0;
        $newStatus = $errors === 0 && $total > 0 ? 'VALIDATED' : 'DRAFT';

        $this->updateReport($reportId, [
            'total' => $total,
            'valid' => $valid,
            'warning' => $warnings,
            'error' => $errors,
            'status' => $newStatus,
            'updated_at' => now(),
        ]);

        $this->log(
            $reportId,
            'VALIDATE',
            $errors === 0 ? 'SUCCESS' : 'ERROR',
            $errors === 0
                ? "Validation completed with {$warnings} data-warning record(s) and no blocking errors."
                : "Validation found {$errors} record(s) with blocking system/structural errors.",
            $total,
            compact('valid', 'warnings', 'errors'),
            $userId,
            $ip
        );

        return $this->getReport($reportId);
    }

    public function finalise(int $reportId, ?int $userId = null, ?string $ip = null): stdClass
    {
        return DB::transaction(function () use ($reportId, $userId, $ip) {
            $report = $this->validateStoredReport($reportId, $userId, $ip);

            $readiness = $this->readiness();
            if (!$readiness['ready']) {
                $messages = collect($readiness['issues'])->pluck('message')->implode(' ');

                throw new RuntimeException('CRB configuration is not ready. ' . $messages);
            }

            if ($report->error_records > 0) {
                throw new RuntimeException("This report has {$report->error_records} record(s) with blocking system/structural errors and cannot be finalised.");
            }

            if ($report->total_records < 1) {
                throw new RuntimeException('An empty CRB report cannot be finalised.');
            }

            $filename = $this->fileName($report);
            $path = 'crb/' . $report->report_date->format('Ymd') . '/' . $filename;

            $content = $this->renderStoredReportContent($reportId);

            if ($content === '') {
                throw new RuntimeException('The CRB report file would be empty.');
            }

            Storage::disk('local')->put($path, $content);

            $hash = hash('sha256', $content);

            $this->updateReport($reportId, [
                'status' => 'FINALISED',
                'file_name' => $filename,
                'file_path' => $path,
                'file_hash' => $hash,
                'finalised_by' => $userId,
                'finalised_at' => now(),
                'updated_at' => now(),
            ]);

            /*
             * Keep crb_log_status within the existing storage contract.
             * Data-warning detail is already preserved in message/context.
             */
            $finaliseLogStatus = 'SUCCESS';

            $finaliseMessage = $report->warning_records > 0
                ? "CRB submission file finalised with {$report->warning_records} record(s) carrying data-quality/regulatory warnings."
                : 'CRB submission file finalised with no data-quality warnings.';

            $this->log(
                $reportId,
                'FINALISE',
                $finaliseLogStatus,
                $finaliseMessage,
                $report->total_records,
                [
                    'file_name' => $filename,
                    'sha256' => $hash,
                    'warning_records' => $report->warning_records,
                    'blocking_error_records' => $report->error_records,
                ],
                $userId,
                $ip
            );

            return $this->getReport($reportId);
        }, 3);
    }

    public function downloadFile(int $reportId): array
    {
        $report = $this->getReport($reportId);

        if (!in_array($report->status, ['FINALISED', 'FINALIZED', 'SUBMITTED'], true)) {
            throw new RuntimeException('Only finalised or submitted CRB files can be downloaded.');
        }

        if (!$report->file_path || !Storage::disk('local')->exists($report->file_path)) {
            throw new RuntimeException('The finalised CRB file is not present in storage.');
        }

        return [
            'path' => Storage::disk('local')->path($report->file_path),
            'name' => $report->file_name ?: basename($report->file_path),
        ];
    }

    public function markSubmitted(int $reportId, ?int $userId = null, ?string $ip = null): stdClass
    {
        $report = $this->getReport($reportId);

        if (!in_array($report->status, ['FINALISED', 'FINALIZED'], true)) {
            throw new RuntimeException('Only a finalised CRB report can be marked as submitted.');
        }

        $this->updateReport($reportId, [
            'status' => 'SUBMITTED',
            'submitted_by' => $userId,
            'submitted_at' => now(),
            'updated_at' => now(),
        ]);

        $this->log($reportId, 'SUBMIT', 'SUCCESS', 'CRB report marked as submitted by an authorised user.', $report->total_records, [], $userId, $ip);

        return $this->getReport($reportId);
    }

    public function reportExists(string $code, Carbon|string $date, bool $lock = false): bool
    {
        $code = $this->normaliseCode($code);
        $date = $this->normaliseReportDate($code, $date);

        $query = DB::table('sacco_crb_reports')
            ->where($this->requireColumn('reports', 'code'), $code)
            ->whereDate($this->requireColumn('reports', 'date'), $date->format('Y-m-d'));

        if ($lock) {
            $query->lockForUpdate();
        }

        return $query->exists();
    }

    private function recordIterator(string $code, Carbon $date): Generator
    {
        $this->paymentStats($date);

        yield from match ($code) {
            'CE' => $this->ceRecords($date),
            'GI' => $this->giRecords($date),
            'CA' => $this->caRecords($date),
            'DP' => $this->dpRecords($date),
            'MF' => $this->mfRecords($date),
            default => throw new RuntimeException("Unsupported CRB report code {$code}."),
        };
    }

    private function ceRecords(Carbon $date): Generator
    {
        foreach ($this->baseLoanQuery($date)->orderBy('l.loan_id')->cursor() as $row) {
            yield $this->buildCeRecord($row, $date);
        }
    }

    private function giRecords(Carbon $date): Generator
    {
        $query = DB::table('sacco_loan_guarantors as g')
            ->join('sacco_loans as l', 'l.loan_id', '=', 'g.loan_guar_loan_id')
            ->join('sacco_members as b', 'b.member_id', '=', 'l.loan_member')
            ->join('sacco_members as gm', 'gm.member_id', '=', 'g.loan_guar_guarantor_id')
            ->leftJoin('sacco_department as gd', 'gd.department_id', '=', 'gm.member_dept')
            ->leftJoin('sacco_company as gc', 'gc.company_id', '=', 'gd.department_company_id')
            ->where(function ($q) use ($date) {
                $q->where('l.loan_taken_period', '<=', (int) $date->format('Ym'))
                    ->orWhere('l.loan_on', '<=', $this->snapshotEndDb($date));
            })
            ->where('l.loan_amount', '>', 0)
            ->where(function ($q) {
                $q->whereNull('g.loan_guar_deleted')
                    ->orWhere('g.loan_guar_deleted', '<>', 'Y');
            })
            ->select([
                'g.*',
                'l.loan_id',
                'l.loan_amount',
                'l.loan_on',
                'l.loan_taken_period',
                'b.member_id as borrower_member_id',
                'b.member_sacco_id as borrower_client_number',
                'gm.member_id as guarantor_member_id',
                'gm.member_name as guarantor_name',
                'gm.member_national_id as guarantor_national_id',
                'gm.member_phone_no as guarantor_phone',
                'gm.member_gender as guarantor_gender',
                'gm.member_dob as guarantor_dob',
                'gm.member_email as guarantor_email',
                'gm.member_postal_address as guarantor_address',
                'gc.company_name as guarantor_employer',
            ])
            ->orderBy('g.loan_guar_id');

        foreach ($query->cursor() as $row) {
            yield $this->buildGiRecord($row, $date);
        }
    }

    private function caRecords(Carbon $date): Generator
    {
        [$startDb, $endDb] = $this->monthDbRange($date);

        $query = DB::table('sacco_loan_batch_trans_members as a')
            ->join('sacco_members as m', 'm.member_id', '=', 'a.batch_trans_member_id')
            ->leftJoin('sacco_loan_types as lt', 'lt.loan_type_id', '=', 'a.batch_trans_loan_type')
            ->leftJoin('sacco_loans as l', 'l.loan_batch_trans_id', '=', 'a.batch_trans_id')
            ->whereBetween('a.batch_trans_on', [$startDb, $endDb])
            ->select([
                'a.*',
                'm.member_id as crb_member_id',
                'm.member_name as crb_member_name',
                'm.member_sacco_id as crb_member_sacco_id',
                'm.member_national_id as crb_member_national_id',
                'm.member_kra_pin as crb_member_kra_pin',
                'lt.loan_type_name as crb_loan_type_name',
                'lt.loan_type_instant_disbursement as crb_instant',
                'l.loan_id as crb_linked_loan_id',
                'l.loan_on as crb_linked_loan_on',
            ])
            ->orderBy('a.batch_trans_id');

        foreach ($query->cursor() as $row) {
            yield $this->buildCaRecord($row, $date);
        }
    }

    private function dpRecords(Carbon $date): Generator
    {
        $day = $date->format('Y-m-d');

        $daily = DB::table('sacco_loan_payments')
            ->select([
                'loan_payments_loan_id',
                DB::raw('SUM(COALESCE(loan_payments_amount, 0)) AS crb_day_principal'),
                DB::raw('SUM(COALESCE(loan_payments_interest, 0)) AS crb_day_interest'),
                DB::raw('SUM(COALESCE(loan_payments_amount, 0) + COALESCE(loan_payments_interest, 0)) AS crb_day_cash'),
            ])
            ->whereDate('loan_payments_paid_on', $day)
            ->groupBy('loan_payments_loan_id');

        $query = $this->baseLoanQuery($date)
            ->joinSub($daily, 'dp', 'dp.loan_payments_loan_id', '=', 'l.loan_id')
            ->addSelect([
                'dp.crb_day_principal',
                'dp.crb_day_interest',
                'dp.crb_day_cash',
            ])
            ->orderBy('l.loan_id');

        $known = $this->priorReportedLoanIds($date);

        foreach ($query->cursor() as $row) {
            $cash = (float) ($row->crb_day_cash ?? 0);

            if (abs($cash) < 0.005) {
                continue;
            }

            yield $this->buildDpRecord($row, $date, isset($known[(int) $row->loan_id]));
        }
    }

    private function mfRecords(Carbon $date): Generator
    {
        [$startDb, $endDb] = $this->dayDbRange($date);

        $query = $this->baseLoanQuery($date)
            ->where('lt.loan_type_instant_disbursement', 1)
            ->whereBetween('l.loan_on', [$startDb, $endDb])
            ->orderBy('l.loan_id');

        foreach ($query->cursor() as $row) {
            yield $this->buildMfRecord($row, $date);
        }
    }

    private function baseLoanQuery(Carbon $date): Builder
    {
        return DB::table('sacco_loans as l')
            ->join('sacco_members as m', 'm.member_id', '=', 'l.loan_member')
            ->leftJoin('sacco_loan_types as lt', 'lt.loan_type_id', '=', 'l.loan_loan_type')
            ->leftJoin('sacco_loan_batch_trans_members as a', 'a.batch_trans_id', '=', 'l.loan_batch_trans_id')
            ->leftJoin('sacco_department as d', 'd.department_id', '=', 'm.member_dept')
            ->leftJoin('sacco_company as c', 'c.company_id', '=', 'd.department_company_id')
            ->where('l.loan_amount', '>', 0)
            ->where(function ($q) use ($date) {
                $q->where('l.loan_taken_period', '<=', (int) $date->format('Ym'))
                    ->orWhere('l.loan_on', '<=', $this->snapshotEndDb($date));
            })
            ->select([
                'l.*',
                'm.member_id as crb_member_id',
                'm.member_name as crb_member_name',
                'm.member_sacco_id as crb_member_sacco_id',
                'm.member_national_id as crb_member_national_id',
                'm.member_phone_no as crb_member_phone',
                'm.member_gender as crb_member_gender',
                'm.member_email as crb_member_email',
                'm.member_postal_address as crb_member_address',
                'm.member_kra_pin as crb_member_kra_pin',
                'm.member_dob as crb_member_dob',
                'c.company_name as crb_employer_name',
                'a.batch_trans_present_designation as crb_designation',
                'a.batch_trans_terms_of_employment as crb_employment_terms',
                'a.batch_trans_payroll_number as crb_payroll_number',
                'lt.loan_type_name as crb_loan_type_name',
                'lt.loan_type_duration as crb_loan_type_duration',
                'lt.loan_type_instant_disbursement as crb_instant',
            ]);
    }

