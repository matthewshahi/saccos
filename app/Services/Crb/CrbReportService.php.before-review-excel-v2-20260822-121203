    private function payload(string $tableKey, array $logical): array
    {
        $payload = [];

        foreach ($logical as $key => $value) {
            $column = $this->column($tableKey, $key);

            if ($column) {
                $payload[$column] = $value;
            }
        }

        return $payload;
    }

    private function rowValue(object $row, string $tableKey, string $logical, mixed $default = null): mixed
    {
        $column = $this->column($tableKey, $logical);

        if (!$column || !property_exists($row, $column)) {
            return $default;
        }

        return $row->{$column};
    }

    private function column(string $tableKey, string $logical): ?string
    {
        $table = match ($tableKey) {
            'reports' => 'sacco_crb_reports',
            'records' => 'sacco_crb_report_records',
            'logs' => 'sacco_crb_report_logs',
            default => throw new RuntimeException("Unknown CRB table key {$tableKey}."),
        };

        $cacheKey = "{$tableKey}.{$logical}";

        if (array_key_exists($cacheKey, $this->columnCache)) {
            return $this->columnCache[$cacheKey];
        }

        $columnsKey = "{$tableKey}.__columns";

        if (!isset($this->columnCache[$columnsKey])) {
            $this->columnCache[$columnsKey] = Schema::getColumnListing($table);
        }

        $columns = $this->columnCache[$columnsKey];

        foreach (self::COLUMN_CANDIDATES[$tableKey][$logical] ?? [] as $candidate) {
            if (in_array($candidate, $columns, true)) {
                return $this->columnCache[$cacheKey] = $candidate;
            }
        }

        return $this->columnCache[$cacheKey] = null;
    }

    private function requireColumn(string $tableKey, string $logical): string
    {
        $column = $this->column($tableKey, $logical);

        if (!$column) {
            $table = match ($tableKey) {
                'reports' => 'sacco_crb_reports',
                'records' => 'sacco_crb_report_records',
                'logs' => 'sacco_crb_report_logs',
            };

            throw new RuntimeException("CRB storage schema mismatch: cannot find logical column '{$logical}' on {$table}.");
        }

        return $column;
    }

    private function default(string $name, mixed $fallback = null): mixed
    {
        if ($this->defaultsCache === null) {
            $this->defaultsCache = DB::table('sacco_defaults')
                ->where(function ($query) {
                    $query->where('default_name', 'like', 'CRB_%')
                        ->orWhere('default_name', 'threshold_amount');
                })
                ->pluck('default_value', 'default_name')
                ->all();
        }

        return array_key_exists($name, $this->defaultsCache)
            ? $this->defaultsCache[$name]
            : $fallback;
    }

    private function lenderRegisteredName(): string
    {
        return $this->cleanText((string) $this->default('CRB_REGISTERED_NAME', ''), 50);
    }

    private function lenderTradingName(): string
    {
        return $this->cleanText((string) $this->default('CRB_TRADING_NAME', ''), 50);
    }

    private function branchName(): string
    {
        return $this->cleanText((string) $this->default('CRB_BRANCH_NAME', ''), 50);
    }

    private function institutionCode(): string
    {
        $digits = preg_replace('/\D+/', '', (string) $this->default('CRB_INSTITUTION_CODE', '')) ?? '';

        if ($digits === '' || strlen($digits) > 3) {
            return '';
        }

        return str_pad($digits, 3, '0', STR_PAD_LEFT);
    }

    private function branchCode(): string
    {
        $raw = strtoupper(trim((string) $this->default('CRB_BRANCH_CODE', '')));

        if (preg_match('/^S\d{6}$/', $raw)) {
            return $raw;
        }

        $branchDigits = preg_replace('/\D+/', '', $raw) ?? '';
        $institution = $this->institutionCode();

        if ($institution === '' || $branchDigits === '' || strlen($branchDigits) > 3) {
            return '';
        }

        return 'S' . $institution . str_pad($branchDigits, 3, '0', STR_PAD_LEFT);
    }

    private function dbTimezone(): string
    {
        $timezone = trim((string) $this->default('CRB_DB_TIMEZONE', 'UTC'));

        try {
            new \DateTimeZone($timezone);

            return $timezone;
        } catch (\Throwable) {
            return 'UTC';
        }
    }

    private function dbDateToNairobi(mixed $value): ?Carbon
    {
        if ($value === null || trim((string) $value) === '') {
            return null;
        }

        try {
            return Carbon::parse((string) $value, $this->dbTimezone())->setTimezone(self::APP_TZ);
        } catch (\Throwable) {
            return null;
        }
    }

    private function snapshotEndDb(Carbon $date): string
    {
        return $date->copy()->endOfDay()->setTimezone($this->dbTimezone())->format('Y-m-d H:i:s');
    }

    private function dayDbRange(Carbon $date): array
    {
        return [
            $date->copy()->startOfDay()->setTimezone($this->dbTimezone())->format('Y-m-d H:i:s'),
            $date->copy()->endOfDay()->setTimezone($this->dbTimezone())->format('Y-m-d H:i:s'),
        ];
    }

    private function monthDbRange(Carbon $date): array
    {
        return [
            $date->copy()->startOfMonth()->startOfDay()->setTimezone($this->dbTimezone())->format('Y-m-d H:i:s'),
            $date->copy()->endOfMonth()->endOfDay()->setTimezone($this->dbTimezone())->format('Y-m-d H:i:s'),
        ];
    }

    private function money(float|int|string|null $value): string
    {
        $amount = is_numeric($value) ? (float) $value : 0.0;
        $cents = (int) round($amount * 100, 0, PHP_ROUND_HALF_UP);

        return (string) $cents;
    }

    private function cleanField(mixed $value): string
    {
        return $this->cleanText((string) ($value ?? ''), null);
    }

    private function cleanText(string $value, ?int $maxLength = null): string
    {
        $value = str_replace(["|", "\r", "\n", "\t"], ' ', $value);
        $value = preg_replace('/\s+/u', ' ', $value) ?? '';
        $value = trim($value);
        $value = $this->ascii($value);

        if ($maxLength !== null && $maxLength > 0) {
            $value = substr($value, 0, $maxLength);
        }

        return $value;
    }

    private function ascii(string $value): string
    {
        if ($value === '') {
            return '';
        }

        $converted = @iconv('UTF-8', 'ASCII//TRANSLIT//IGNORE', $value);

        return $converted === false ? preg_replace('/[^\x20-\x7E]/', '', $value) ?? '' : $converted;
    }

    private function validationStatus(array $issues): string
    {
        foreach ($issues as $issue) {
            if (($issue['level'] ?? '') === 'ERROR') {
                return 'ERROR';
            }
        }

        return $issues === [] ? 'VALID' : 'WARNING';
    }

    private function warn(
        array &$issues,
        string $code,
        string $message,
        string $category = 'DATA_QUALITY'
    ): void {
        $issues[] = [
            'level' => 'WARNING',
            'category' => $category,
            'code' => strtoupper(trim($code)),
            'message' => $message,
        ];
    }

    /**
     * Source/member/loan data problems are advisory.
     *
     * They must be visible to the SACCO, but they do not make the CRB module
     * itself fail and do not by themselves block finalisation.
     *
     * Only technical/structural conditions remain blocking ERRORs.
     */
    private function error(array &$issues, string $code, string $message): void
    {
        $code = strtoupper(trim($code));

        if ($this->isBlockingIssueCode($code)) {
            $issues[] = [
                'level' => 'ERROR',
                'category' => 'BLOCKING_SYSTEM',
                'code' => $code,
                'message' => $message,
            ];

            return;
        }

        $this->warn(
            $issues,
            $code,
            $message,
            'REGULATORY_DATA'
        );
    }

    private function isBlockingIssueCode(string $code): bool
    {
        $code = strtoupper(trim($code));

        /*
         * These are not merely dirty source data; the generated submission
         * cannot be relied upon technically/structurally.
         */
        if (in_array($code, [
            'KES_BALANCE_CONVERSION_UNAVAILABLE',
            'ACCOUNT_NOT_PREVIOUSLY_REPORTED',
        ], true)) {
            return true;
        }

        foreach ([
            'SYSTEM_',
            'SCHEMA_',
            'STORAGE_',
            'INTERNAL_',
            'FILE_STRUCTURE_',
        ] as $prefix) {
            if (str_starts_with($code, $prefix)) {
                return true;
            }
        }

        return false;
    }

    /**
     * Re-apply the current policy to a frozen DRAFT created under an older
     * validation policy. Finalised/submitted reports remain immutable.
     */
    private function normaliseIssues(array $issues): array
    {
        $normalised = [];

        foreach ($issues as $issue) {
            if (!is_array($issue)) {
                continue;
            }

            $code = strtoupper(trim((string) ($issue['code'] ?? 'UNKNOWN')));

            if ($this->isBlockingIssueCode($code)) {
                $issue['level'] = 'ERROR';
                $issue['category'] = 'BLOCKING_SYSTEM';
            } else {
                $issue['level'] = 'WARNING';
                $issue['category'] = $issue['category'] ?? 'REGULATORY_DATA';
            }

            $issue['code'] = $code;
            $normalised[] = $issue;
        }

        return $normalised;
    }

    private function duplicateNationalIds(): array
    {
        if ($this->duplicateNationalIdsCache !== null) {
            return $this->duplicateNationalIdsCache;
        }

        $rows = DB::table('sacco_members')
            ->whereNotNull('member_national_id')
            ->whereRaw("TRIM(member_national_id) <> ''")
            ->selectRaw(
                'UPPER(TRIM(member_national_id)) AS national_id, COUNT(DISTINCT member_id) AS member_count'
            )
            ->groupBy(DB::raw('UPPER(TRIM(member_national_id))'))
            ->havingRaw('COUNT(DISTINCT member_id) > 1')
            ->get();

        $this->duplicateNationalIdsCache = [];

        foreach ($rows as $row) {
            $id = strtoupper(trim((string) ($row->national_id ?? '')));

            if ($id !== '') {
                $this->duplicateNationalIdsCache[$id] = (int) ($row->member_count ?? 0);
            }
        }

        return $this->duplicateNationalIdsCache;
    }

    private function normaliseCode(string $code): string
    {
        $code = strtoupper(trim($code));

        if (!isset(self::REPORT_TYPES[$code])) {
            throw new RuntimeException('Unsupported CRB report code. Supported codes: ' . implode(', ', array_keys(self::REPORT_TYPES)) . '.');
        }

        return $code;
    }
}
