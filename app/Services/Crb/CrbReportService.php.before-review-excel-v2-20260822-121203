    private function gender(mixed $value, array &$issues, bool $required): string
    {
        $gender = strtoupper(trim((string) ($value ?? '')));

        if (in_array($gender, ['M', 'F'], true)) {
            return $gender;
        }

        if ($required) {
            $this->error($issues, 'GENDER_MISSING_OR_INVALID', 'Gender must be M or F for this CRB record.');
        }

        return '';
    }

    private function phone(string $value, array &$issues, bool $required): string
    {
        $digits = preg_replace('/\D+/', '', $value) ?? '';

        if ($digits === '') {
            if ($required) {
                $this->error($issues, 'MOBILE_PHONE_MISSING', 'Mobile phone number is mandatory for this CRB record.');
            } else {
                $this->warn($issues, 'MOBILE_PHONE_MISSING', 'Mobile phone number is not available.');
            }

            return '';
        }

        if (str_starts_with($digits, '0')) {
            $digits = '254' . substr($digits, 1);
        } elseif (strlen($digits) === 9 && in_array($digits[0] ?? '', ['1', '7'], true)) {
            $digits = '254' . $digits;
        }

        if (!str_starts_with($digits, '254') || strlen($digits) < 11 || strlen($digits) > 13) {
            if ($required) {
                $this->error($issues, 'MOBILE_PHONE_INVALID', 'Mobile phone number cannot be normalised to a valid CRB A13 Kenyan number.');
            } else {
                $this->warn($issues, 'MOBILE_PHONE_INVALID', 'Mobile phone number could not be confidently normalised.');
            }
        }

        return substr($digits, 0, 13);
    }

    private function date8(mixed $value, array &$issues, string $missingCode, bool $required): string
    {
        $raw = trim((string) ($value ?? ''));
        $isDob = str_contains(strtoupper($missingCode), 'DATE_OF_BIRTH');

        if (
            $value === null
            || $raw === ''
            || $raw === '0000-00-00'
            || str_starts_with($raw, '0000-00-00')
        ) {
            if ($required) {
                $this->error($issues, $missingCode, 'Required date is missing.');
            }

            return '';
        }

        try {
            $parsed = Carbon::parse($raw);

            if ($isDob) {
                if ($parsed->isFuture()) {
                    $this->warn(
                        $issues,
                        'DATE_OF_BIRTH_FUTURE',
                        'Date of birth is in the future and should be corrected in the member master.',
                        'REGULATORY_DATA'
                    );
                }

                if ($parsed->lt(Carbon::now(self::APP_TZ)->subYears(120))) {
                    $this->warn(
                        $issues,
                        'DATE_OF_BIRTH_IMPLAUSIBLE',
                        'Date of birth implies an age greater than 120 years and should be verified.',
                        'REGULATORY_DATA'
                    );
                }
            }

            return $parsed->format('Ymd');
        } catch (\Throwable) {
            if ($required) {
                $invalidCode = str_ends_with($missingCode, '_MISSING')
                    ? substr($missingCode, 0, -8) . '_INVALID'
                    : $missingCode . '_INVALID';

                $this->error(
                    $issues,
                    $invalidCode,
                    'Required date is invalid.'
                );
            }

            return '';
        }
    }

    private function paymentStats(Carbon $date): array
    {
        $key = $date->format('Y-m-d');

        if (isset($this->paymentStatsCache[$key])) {
            return $this->paymentStatsCache[$key];
        }

        $stats = [];

        DB::table('sacco_loan_payments')
            ->whereDate('loan_payments_paid_on', '<=', $key)
            ->orderBy('loan_payments_loan_id')
            ->orderBy('loan_payments_paid_on')
            ->orderBy('loan_payments_id')
            ->select([
                'loan_payments_loan_id',
                'loan_payments_amount',
                'loan_payments_interest',
                'loan_payments_paid_on',
            ])
            ->chunk(5000, function ($rows) use (&$stats) {
                foreach ($rows as $payment) {
                    $loanId = (int) $payment->loan_payments_loan_id;

                    if (!isset($stats[$loanId])) {
                        $stats[$loanId] = [
                            'principal_total' => 0.0,
                            'latest_date' => null,
                            'latest_cash' => 0.0,
                        ];
                    }

                    $principal = (float) ($payment->loan_payments_amount ?? 0);
                    $interest = (float) ($payment->loan_payments_interest ?? 0);
                    $day = $payment->loan_payments_paid_on ? (string) $payment->loan_payments_paid_on : null;

                    $stats[$loanId]['principal_total'] += $principal;

                    if ($day !== null) {
                        if ($stats[$loanId]['latest_date'] === null || $day > $stats[$loanId]['latest_date']) {
                            $stats[$loanId]['latest_date'] = $day;
                            $stats[$loanId]['latest_cash'] = $principal + $interest;
                        } elseif ($day === $stats[$loanId]['latest_date']) {
                            $stats[$loanId]['latest_cash'] += $principal + $interest;
                        }
                    }
                }
            });

        $this->paymentStatsCache[$key] = $stats;

        return $stats;
    }

    private function paymentStat(int $loanId, Carbon $date): array
    {
        $stats = $this->paymentStats($date);

        return $stats[$loanId] ?? [
            'principal_total' => 0.0,
            'latest_date' => null,
            'latest_cash' => 0.0,
        ];
    }

    private function priorReportedLoanIds(Carbon $date): array
    {
        $key = $date->format('Y-m-d');

        if (isset($this->priorReportedCache[$key])) {
            return $this->priorReportedCache[$key];
        }

        $recordLoanCol = $this->column('records', 'loan_id');
        $recordReportCol = $this->column('records', 'report_id');

        if (!$recordLoanCol || !$recordReportCol) {
            return $this->priorReportedCache[$key] = [];
        }

        $reportIdCol = $this->requireColumn('reports', 'id');
        $reportCodeCol = $this->requireColumn('reports', 'code');
        $reportStatusCol = $this->requireColumn('reports', 'status');
        $reportDateCol = $this->requireColumn('reports', 'date');

        $ids = DB::table('sacco_crb_report_records as rr')
            ->join('sacco_crb_reports as r', "r.{$reportIdCol}", '=', "rr.{$recordReportCol}")
            ->whereIn("r.{$reportCodeCol}", ['CE', 'MF'])
            ->whereIn("r.{$reportStatusCol}", ['FINALISED', 'FINALIZED', 'SUBMITTED'])
            ->whereDate("r.{$reportDateCol}", '<=', $key)
            ->whereNotNull("rr.{$recordLoanCol}")
            ->distinct()
            ->pluck("rr.{$recordLoanCol}")
            ->mapWithKeys(fn ($id) => [(int) $id => true])
            ->all();

        return $this->priorReportedCache[$key] = $ids;
    }

    private function fileName(stdClass $report): string
    {
        $readiness = $this->readiness();

        if (!$readiness['ready']) {
            throw new RuntimeException('CRB filename cannot be built while required CRB configuration is incomplete.');
        }

        $spec = strtoupper((string) $readiness['settings']['specification_code']);
        $periodCode = $report->frequency === 'MONTHLY' ? 'M' : 'D';
        $version = str_pad((string) $report->version, 3, '0', STR_PAD_LEFT);

        return 'CRB'
            . $spec
            . $periodCode
            . $report->code
            . $report->report_date->format('Ymd')
            . $version
            . '.S'
            . $this->institutionCode();
    }

    private function reclassifyStoredRecordIssues(int $reportId): void
    {
        $idCol = $this->requireColumn('records', 'id');
        $reportCol = $this->requireColumn('records', 'report_id');
        $statusCol = $this->requireColumn('records', 'status');
        $errorsCol = $this->requireColumn('records', 'errors');
        $dataCol = $this->requireColumn('records', 'data');

        DB::table('sacco_crb_report_records')
            ->where($reportCol, $reportId)
            ->orderBy($idCol)
            ->select([$idCol, $errorsCol, $dataCol])
            ->chunk(500, function ($rows) use (
                $idCol,
                $statusCol,
                $errorsCol,
                $dataCol
            ) {
                foreach ($rows as $row) {
                    $issues = json_decode((string) ($row->{$errorsCol} ?? ''), true);

                    if (!is_array($issues)) {
                        $issues = [];
                    }

                    $issues = $this->normaliseIssues($issues);
                    $status = $this->validationStatus($issues);

                    $payload = json_decode((string) ($row->{$dataCol} ?? ''), true);

                    if (is_array($payload)) {
                        if (!isset($payload['meta']) || !is_array($payload['meta'])) {
                            $payload['meta'] = [];
                        }

                        $payload['meta']['issues'] = $issues;
                    }

                    DB::table('sacco_crb_report_records')
                        ->where($idCol, $row->{$idCol})
                        ->update([
                            $statusCol => $status,
                            $errorsCol => json_encode(
                                $issues,
                                JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES
                            ),
                            $dataCol => is_array($payload)
                                ? json_encode(
                                    $payload,
                                    JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES
                                )
                                : $row->{$dataCol},
                        ]);
                }
            });
    }

    private function renderStoredReportContent(int $reportId): string
    {
        $dataCol = $this->requireColumn('records', 'data');
        $reportCol = $this->requireColumn('records', 'report_id');
        $orderCol = $this->column('records', 'sequence') ?: $this->requireColumn('records', 'id');

        $lines = [];

        DB::table('sacco_crb_report_records')
            ->where($reportCol, $reportId)
            ->orderBy($orderCol)
            ->select($dataCol)
            ->chunk(1000, function ($rows) use (&$lines, $dataCol) {
                foreach ($rows as $row) {
                    $payload = json_decode((string) $row->{$dataCol}, true);
                    $fields = is_array($payload['fields'] ?? null) ? $payload['fields'] : [];
                    $line = implode('|', array_map(fn ($value) => $this->cleanField($value), $fields));
                    $line = $this->ascii($line);
                    $lines[] = $line;
                }
            });

        if ($lines === []) {
            return '';
        }

        return implode("\r\n", $lines) . "\r\n";
    }

    private function nextVersion(string $code, Carbon $date): int
    {
        $versionCol = $this->requireColumn('reports', 'version');

        $max = DB::table('sacco_crb_reports')
            ->where($this->requireColumn('reports', 'code'), $code)
            ->whereDate($this->requireColumn('reports', 'date'), $date->format('Y-m-d'))
            ->max($versionCol);

        return min(999, ((int) $max) + 1);
    }

