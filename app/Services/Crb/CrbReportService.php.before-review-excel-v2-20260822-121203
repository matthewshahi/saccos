    private function buildMfRecord(object $row, Carbon $date): array
    {
        $issues = [];
        $names = $this->splitName((string) $row->crb_member_name, $issues);
        $identity = $this->identity($row, $issues, true);
        $phone = $this->phone((string) ($row->crb_member_phone ?? ''), $issues, true);
        $opened = $this->loanOpenedDate($row, $date, $issues);
        $financial = $this->loanFinancialState($row, $date, $issues);
        $status = $this->accountStatus($row, $financial, $date, $issues, $opened);
        $risk = $this->riskClass((int) $financial['days_in_arrears'], (int) $financial['instalments_in_arrears'], (float) $financial['overdue_balance']);
        $duration = $this->repaymentPeriod($row, $issues);
        $account = $this->accountNumber((int) $row->loan_id, $issues);
        $client = $this->clientNumber($row, $issues);
