        if ($client === '') {
            $client = (string) ($row->crb_member_id ?? '');
            $this->warn($issues, 'CLIENT_NUMBER_FALLBACK', 'Member ID was used because member_sacco_id is blank.');
        }

        return $this->cleanText($client, 20);
