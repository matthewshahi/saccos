    public function readiness(): array
    {
        $required = [
            'CRB_REGISTERED_NAME' => 'Registered lender name',
            'CRB_TRADING_NAME' => 'Trading name',
            'CRB_INSTITUTION_CODE' => 'CRB institution code',
            'CRB_BRANCH_NAME' => 'Branch name',
            'CRB_BRANCH_CODE' => 'Branch code',
            'CRB_SPECIFICATION_CODE' => 'CRB specification code (B, M, D or F)',
        ];

        $issues = [];
        $settings = [];

        foreach ($required as $name => $label) {
            $value = trim((string) $this->default($name, ''));
            $settings[$name] = $value;

            if ($value === '') {
                $issues[] = [
                    'level' => 'ERROR',
                    'code' => 'CONFIG_MISSING',
                    'message' => "{$label} is not configured ({$name}).",
                ];
            }
        }

        $spec = strtoupper($settings['CRB_SPECIFICATION_CODE'] ?? '');
        if ($spec !== '' && !in_array($spec, ['B', 'M', 'D', 'F'], true)) {
            $issues[] = [
                'level' => 'ERROR',
                'code' => 'INVALID_SPECIFICATION_CODE',
                'message' => 'CRB_SPECIFICATION_CODE must be one of B, M, D or F as defined by the DST filename convention.',
            ];
        }

        $riskBasis = 'SACCO';


        $institution = preg_replace('/\D+/', '', (string) ($settings['CRB_INSTITUTION_CODE'] ?? ''));
        if (($settings['CRB_INSTITUTION_CODE'] ?? '') !== '' && ($institution === '' || strlen($institution) > 3)) {
            $issues[] = [
                'level' => 'ERROR',
                'code' => 'INVALID_INSTITUTION_CODE',
                'message' => 'CRB_INSTITUTION_CODE must contain a numeric institution identifier of at most three digits.',
            ];
        }

        if (($settings['CRB_BRANCH_CODE'] ?? '') !== '' && $this->branchCode() === '') {
            $issues[] = [
                'level' => 'ERROR',
                'code' => 'INVALID_BRANCH_CODE',
                'message' => 'CRB_BRANCH_CODE must be either the numeric branch identifier (up to three digits) or the full SXXXYYY SACCO branch code.',
            ];
        }

        $currency = strtoupper((string) $this->default('CRB_DEFAULT_CURRENCY', 'KES'));
        if (!preg_match('/^[A-Z]{3}$/', $currency)) {
            $issues[] = [
                'level' => 'ERROR',
                'code' => 'INVALID_DEFAULT_CURRENCY',
                'message' => 'CRB_DEFAULT_CURRENCY must be a three-letter ISO currency code.',
            ];
        }

        $nationality = strtoupper((string) $this->default('CRB_DEFAULT_NATIONALITY', 'KE'));
        if (!preg_match('/^[A-Z]{2}$/', $nationality)) {
            $issues[] = [
                'level' => 'ERROR',
                'code' => 'INVALID_DEFAULT_NATIONALITY',
                'message' => 'CRB_DEFAULT_NATIONALITY must be a two-letter ISO country code.',
            ];
        }

        $hasErrors = collect($issues)->contains(fn ($issue) => $issue['level'] === 'ERROR');

        return [
            'ready' => !$hasErrors,
            'issues' => $issues,
            'settings' => [
                'registered_name' => $this->default('CRB_REGISTERED_NAME', ''),
                'trading_name' => $this->default('CRB_TRADING_NAME', ''),
                'institution_code' => $this->institutionCode(),
                'branch_name' => $this->default('CRB_BRANCH_NAME', ''),
                'branch_code' => $this->branchCode(),
                'specification_code' => $spec,
                'risk_basis' => $riskBasis,
                'currency' => $currency,
                'nationality' => $nationality,
                'db_timezone' => $this->dbTimezone(),
                'negative_information_threshold' => (float) $this->default('CRB_NEGATIVE_INFORMATION_THRESHOLD', 1000),
                'apply_negative_threshold' => strtoupper((string) $this->default('CRB_APPLY_NEGATIVE_THRESHOLD', 'N')) === 'Y',
            ],
        ];
    }

    public function defaultReportDate(string $code): Carbon
    {
        $code = $this->normaliseCode($code);
        $now = Carbon::now(self::APP_TZ)->startOfDay();

        if (self::REPORT_TYPES[$code]['frequency'] === 'MONTHLY') {
            return $now->copy()->subMonthNoOverflow()->endOfMonth()->startOfDay();
        }

        return $now->copy()->subDay();
    }

    public function normaliseReportDate(string $code, Carbon|string|null $date): Carbon
    {
        $code = $this->normaliseCode($code);

        if ($date instanceof Carbon) {
            $resolved = $date->copy()->setTimezone(self::APP_TZ)->startOfDay();
        } elseif ($date === null || trim((string) $date) === '') {
            $resolved = $this->defaultReportDate($code);
        } else {
            try {
                $resolved = Carbon::createFromFormat('Y-m-d', (string) $date, self::APP_TZ)->startOfDay();
            } catch (\Throwable) {
                throw new RuntimeException('Invalid CRB report date. Expected YYYY-MM-DD.');
            }
        }

        if (self::REPORT_TYPES[$code]['frequency'] === 'MONTHLY') {
            $resolved = $resolved->endOfMonth()->startOfDay();
        }

        return $resolved;
    }

    public function preview(string $code, Carbon|string|null $date, int $limit = 100): array
    {
        $code = $this->normaliseCode($code);
        $date = $this->normaliseReportDate($code, $date);
        $limit = max(1, min($limit, 250));

        $sample = [];
        $sampleCounts = ['VALID' => 0, 'WARNING' => 0, 'ERROR' => 0];

        foreach ($this->recordIterator($code, $date) as $record) {
            $status = $this->validationStatus($record['issues']);
            $record['validation_status'] = $status;
            $sampleCounts[$status]++;

            $sample[] = $record;

            if (count($sample) >= $limit) {
                break;
            }
        }

        return [
            'code' => $code,
            'type' => self::REPORT_TYPES[$code],
            'date' => $date,
            'candidate_count' => $this->candidateCount($code, $date),
            'sample_limit' => $limit,
            'sample_count' => count($sample),
            'sample_counts' => $sampleCounts,
            'field_names' => self::FIELD_NAMES[$code],
            'records' => $sample,
            'readiness' => $this->readiness(),
        ];
    }

    public function generate(
        string $code,
        Carbon|string|null $date,
        ?int $userId = null,
        ?string $ip = null,
        bool $ifMissing = false
    ): ?int {
        $code = $this->normaliseCode($code);
        $date = $this->normaliseReportDate($code, $date);

        if ($ifMissing && $this->reportExists($code, $date)) {
            return null;
        }

        $candidateCount = $this->candidateCount($code, $date);
        if ($candidateCount < 1 && $ifMissing) {
            return null;
        }

        if ($candidateCount < 1) {
            throw new RuntimeException("No {$code} CRB records were found for {$date->format('Y-m-d')}.");
        }

        return DB::transaction(function () use ($code, $date, $userId, $ip, $ifMissing) {
            if ($ifMissing && $this->reportExists($code, $date, true)) {
                return null;
            }

            $version = $this->nextVersion($code, $date);
            $reportId = $this->insertReport([
                'code' => $code,
                'frequency' => self::REPORT_TYPES[$code]['frequency'],
                'date' => $date->format('Y-m-d'),
                'period' => $date->format('Ym'),
                'version' => $version,
                'status' => 'DRAFT',
                'total' => 0,
                'valid' => 0,
                'warning' => 0,
                'error' => 0,
                'generated_by' => $userId,
                'generated_at' => now(),
                'ip' => $ip,
                'created_at' => now(),
                'updated_at' => now(),
            ]);

            $counts = ['VALID' => 0, 'WARNING' => 0, 'ERROR' => 0];
            $sequence = 0;
            $batch = [];

            foreach ($this->recordIterator($code, $date) as $record) {
                $sequence++;
                $status = $this->validationStatus($record['issues']);
                $counts[$status]++;

                $payload = [
                    'field_names' => self::FIELD_NAMES[$code],
                    'fields' => $record['fields'],
                    'summary' => $record['summary'],
                    'meta' => [
                        'report_code' => $code,
                        'report_date' => $date->format('Y-m-d'),
                        'issues' => $record['issues'],
                    ],
                ];

                $batch[] = $this->recordInsertPayload([
                    'report_id' => $reportId,
                    'sequence' => $sequence,
                    'member_id' => $record['member_id'],
                    'loan_id' => $record['loan_id'],
                    'source_type' => $record['source_type'],
                    'source_id' => $record['source_id'],
                    'status' => $status,
                    'data' => json_encode($payload, JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE),
                    'errors' => json_encode($record['issues'], JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE),
                    'created_at' => now(),
                    'updated_at' => now(),
                ]);

                if (count($batch) >= 250) {
                    DB::table('sacco_crb_report_records')->insert($batch);
                    $batch = [];
                }
            }

            if ($batch !== []) {
                DB::table('sacco_crb_report_records')->insert($batch);
            }

            if ($sequence < 1) {
                if ($ifMissing) {
                    $this->deleteReportInternally($reportId);

                    return null;
                }

                throw new RuntimeException("No usable {$code} CRB records remained after source filtering.");
            }

            $this->updateReport($reportId, [
                'total' => $sequence,
                'valid' => $counts['VALID'],
                'warning' => $counts['WARNING'],
                'error' => $counts['ERROR'],
                'updated_at' => now(),
            ]);

            $this->log($reportId, 'GENERATE', 'SUCCESS', "Generated {$code} report draft.", $sequence, [
                'report_date' => $date->format('Y-m-d'),
                'version' => $version,
                'valid' => $counts['VALID'],
                'warnings' => $counts['WARNING'],
                'errors' => $counts['ERROR'],
            ], $userId, $ip);

            return $reportId;
        }, 3);
    }

    public function generateIfMissing(
        string $code,
        Carbon|string|null $date,
        ?int $userId = null,
        ?string $ip = null
    ): ?int {
        return $this->generate($code, $date, $userId, $ip, true);
    }

    public function reportStats(): array
    {
        $statusCol = $this->requireColumn('reports', 'status');

        $grouped = DB::table('sacco_crb_reports')
            ->select($statusCol, DB::raw('COUNT(*) AS total'))
            ->groupBy($statusCol)
            ->pluck('total', $statusCol)
            ->mapWithKeys(fn ($value, $key) => [strtoupper((string) $key) => (int) $value])
            ->all();

        $errorCol = $this->column('reports', 'error');

        return [
            'total' => array_sum($grouped),
            'draft' => ($grouped['DRAFT'] ?? 0) + ($grouped['VALIDATED'] ?? 0),
            'finalised' => ($grouped['FINALISED'] ?? 0) + ($grouped['FINALIZED'] ?? 0),
            'submitted' => $grouped['SUBMITTED'] ?? 0,
            'with_errors' => $errorCol
                ? DB::table('sacco_crb_reports')->where($errorCol, '>', 0)->count()
                : 0,
        ];
    }

    public function recentReports(int $limit = 10)
    {
        $idCol = $this->requireColumn('reports', 'id');

        return DB::table('sacco_crb_reports')
            ->orderByDesc($idCol)
            ->limit(max(1, min($limit, 50)))
            ->get()
            ->map(fn ($row) => $this->normaliseReportRow($row));
    }

    public function paginateReports(array $filters = [], int $perPage = 25): LengthAwarePaginator
    {
        $query = DB::table('sacco_crb_reports');

        if (!empty($filters['code'])) {
            $query->where($this->requireColumn('reports', 'code'), strtoupper((string) $filters['code']));
        }

        if (!empty($filters['status'])) {
            $query->where($this->requireColumn('reports', 'status'), strtoupper((string) $filters['status']));
        }

        if (!empty($filters['date_from'])) {
            $query->whereDate($this->requireColumn('reports', 'date'), '>=', $filters['date_from']);
        }

        if (!empty($filters['date_to'])) {
            $query->whereDate($this->requireColumn('reports', 'date'), '<=', $filters['date_to']);
        }

        $paginator = $query
            ->orderByDesc($this->requireColumn('reports', 'id'))
            ->paginate(max(10, min($perPage, 100)))
            ->withQueryString();

        $paginator->setCollection(
            $paginator->getCollection()->map(fn ($row) => $this->normaliseReportRow($row))
        );

        return $paginator;
    }

    public function getReport(int $id): stdClass
    {
        $row = DB::table('sacco_crb_reports')
            ->where($this->requireColumn('reports', 'id'), $id)
            ->first();

        if (!$row) {
            throw new RuntimeException('CRB report not found.');
        }

        return $this->normaliseReportRow($row);
    }

    public function paginateReportRecords(int $reportId, int $perPage = 50): LengthAwarePaginator
    {
        $query = DB::table('sacco_crb_report_records')
            ->where($this->requireColumn('records', 'report_id'), $reportId);

        $orderCol = $this->column('records', 'sequence') ?: $this->requireColumn('records', 'id');

        $paginator = $query
            ->orderBy($orderCol)
            ->paginate(max(10, min($perPage, 100)))
            ->withQueryString();

        $paginator->setCollection(
            $paginator->getCollection()->map(fn ($row) => $this->normaliseRecordRow($row))
        );

        return $paginator;
    }

    public function reportLogs(int $reportId)
