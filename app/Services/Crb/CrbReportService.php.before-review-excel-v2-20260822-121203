    private function identity(object $row, array &$issues, bool $required): array
    {
        return $this->identityFromValues(
            $row->crb_member_national_id ?? null,
            $issues,
            $required
        );
    }

    private function identityFromValues(mixed $nationalId, array &$issues, bool $required): array
    {
        $number = $this->cleanText((string) ($nationalId ?? ''), 30);

        if ($number === '') {
            if ($required) {
                $this->error(
                    $issues,
                    'PRIMARY_ID_MISSING',
                    'Primary identification document number is missing.'
                );
            }

            return ['type' => '', 'number' => ''];
        }

        /*
         * Known migration artefacts such as:
         *     11898709_dup1
         *     27288248_dup2
         *
         * Do not fabricate a replacement. Keep the source value visible and
         * notify the SACCO to correct the member master.
         */
        if (preg_match('/_dup\d+$/i', $number) === 1) {
            $this->warn(
                $issues,
                'PRIMARY_ID_SYNTHETIC',
                'Primary identification number appears to contain a migration duplicate suffix (_dupN). Confirm and correct the member National ID.',
                'REGULATORY_DATA'
            );
        }

        $normalised = strtoupper(trim($number));

        if ($normalised !== '' && isset($this->duplicateNationalIds()[$normalised])) {
            $this->warn(
                $issues,
                'DUPLICATE_PRIMARY_ID',
                'The same primary identification number is attached to more than one SACCO member record. Review the member master for duplication.',
                'REGULATORY_DATA'
            );
        }

        return ['type' => '001', 'number' => $number];
    }

    private function splitName(string $fullName, array &$issues): array
    {
        $fullName = trim(preg_replace('/\s+/u', ' ', $fullName) ?? '');
        $parts = $fullName === '' ? [] : preg_split('/\s+/u', $fullName);

        if (!$parts || count($parts) < 2) {
            $this->error($issues, 'NAME_COMPONENTS_INSUFFICIENT', 'CRB requires at least a surname and first forename; member_name cannot be reliably split.');

            return [
                'surname' => $this->cleanText($parts[0] ?? '', 50),
                'forename1' => '',
                'forename2' => '',
                'forename3' => '',
            ];
        }

        $forename1 = array_shift($parts);
        $surname = array_pop($parts);
        $forename2 = $parts[0] ?? '';
        $forename3 = count($parts) > 1 ? implode(' ', array_slice($parts, 1)) : '';

        return [
            'surname' => $this->cleanText($surname, 50),
            'forename1' => $this->cleanText($forename1, 50),
            'forename2' => $this->cleanText($forename2, 50),
            'forename3' => $this->cleanText($forename3, 50),
        ];
    }

    private function clientNumber(object $row, array &$issues): string
    {
