############################################

/node_modules/
/public/build/
/public/hot/
/public/storage/
mix-manifest.json
npm-debug.log
yarn-debug.log
yarn-error.log
pnpm-debug.log

############################################
# IDE / Editor Files
############################################

/.idea/
/.vscode/
/.fleet/
/*.code-workspace

############################################
